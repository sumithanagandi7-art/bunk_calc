# ── Server ───────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────
# Local Docker Postgres (docker-compose default)
DATABASE_URL="postgresql://bunk_user:bunk_pass@localhost:5432/bunk_calculator"

# ── JWT ──────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── File Uploads ─────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── LLM Vision ───────────────────────────────
GEMINI_API_KEY=""

# ── Ollama Local Multimodal AI ────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_VISION_MODEL="llama3.2-vision"

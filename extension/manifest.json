{
  "manifest_version": 3,
  "name": "Bunk Calculator Sync",
  "version": "1.0.0",
  "description": "Automatically scrape and sync college portal attendance data directly into Bunk Calculator.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.contineo.in/*",
    "*://*.nitte.edu.in/*",
    "*://*.edu.in/*",
    "*://localhost/*",
    "http://localhost:4000/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.contineo.in/*",
        "*://*.nitte.edu.in/*",
        "*://*.edu.in/*",
        "http://localhost/*",
        "https://localhost/*",
        "*://*/*attendance*",
        "*://*/*portal*"
      ],
      "js": [
        "parsers/normalizer.js",
        "parsers/portalParserV1.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html"
}
